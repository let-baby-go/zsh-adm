# 复制为 .env 后填写：cp .env.example .env
# .env 已被 .gitignore 忽略；不要把真实凭据提交到仓库或写进命令历史。
# 下面带 replace- 前缀的值只是占位符，必须在首次启动前替换。

# 首次启动创建管理员（密码至少 12 位）
WORKDSH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
WORKDSH_BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password
WORKDSH_ORGANIZATION_NAME=WorkDSH 企业

# 32 字节随机密钥的 Base64，生成：openssl rand -base64 32
WORKDSH_SECRETS_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
# 服务器间服务密钥，生成：openssl rand -hex 32
WORKDSH_SECRETS_SERVICE_KEY=replace-with-openssl-rand-hex-32

# 访问入口。改端口时必须同时改 WORKDSH_ADMIN_WEB_ORIGIN，否则登录等写请求会被 Origin 校验拒绝。
WORKDSH_ADMIN_BIND_ADDRESS=127.0.0.1
WORKDSH_ADMIN_PORT=18890
WORKDSH_ADMIN_WEB_ORIGIN=http://127.0.0.1:18890

# 仅 PostgreSQL 叠加栈需要；默认 H2 栈忽略这些值。
WORKDSH_DB_NAME=workdsh
WORKDSH_DB_MAINT_USER=workdsh_owner
WORKDSH_DB_MAINT_PASSWORD=replace-with-maintenance-role-password
WORKDSH_DB_APP_PASSWORD=replace-with-app-role-password

# ---- 以下均为可选，留空或删除即使用默认值 ----

# 模型网关时限：连接、等待上游开始响应、流式中途最长静默、单次响应最长时长
# 调整 RESPONSE_TIMEOUT 或 STREAM_IDLE_TIMEOUT 时，反向代理与负载均衡的读超时要同步调整（见 deploy/docker/README.md「反向代理」）
# WORKDSH_GATEWAY_CONNECT_TIMEOUT=15s
# WORKDSH_GATEWAY_RESPONSE_TIMEOUT=5m
# WORKDSH_GATEWAY_STREAM_IDLE_TIMEOUT=5m
# WORKDSH_GATEWAY_MAX_RESPONSE_DURATION=30m
# 同时进行的模型调用上限（流式与非流式合计，全部组织共享），超出时新请求立即返回 503 gateway_busy
# WORKDSH_GATEWAY_MAX_CONCURRENT_REQUESTS=2000
# 虚拟线程（需 Java 21）；仅排查问题时临时设为 false
# WORKDSH_VIRTUAL_THREADS=true
# 网关缓存内部 Key 与模型接口配置的时长；本实例保存立即生效，多实例部署时其他实例最长延迟这么久；0 表示每次查库
# WORKDSH_GATEWAY_CACHE_TTL=10s

# 数据库连接池：最大连接数与获取连接超时（毫秒）；SQLite 固定 1 个连接，不受影响
# WORKDSH_DB_POOL_SIZE=10
# WORKDSH_DB_CONNECTION_TIMEOUT_MS=30000

# 会话正文存储：database（默认，存主库）或 s3（AWS S3 / MinIO / 阿里云 OSS / 腾讯云 COS 等 S3 兼容服务）
# WORKDSH_BODY_STORE=s3
# WORKDSH_BODY_S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com   # AWS S3 留空
# WORKDSH_BODY_S3_REGION=cn-hangzhou
# WORKDSH_BODY_S3_BUCKET=replace-with-bucket
# WORKDSH_BODY_S3_PREFIX=workdsh
# WORKDSH_BODY_S3_ACCESS_KEY=replace-with-access-key   # 与 SECRET_KEY 同时留空则使用 AWS 默认凭据链
# WORKDSH_BODY_S3_SECRET_KEY=replace-with-secret-key
# WORKDSH_BODY_S3_PATH_STYLE=false                      # MinIO 通常需要 true
# 切换到 s3 后，设为 true 启动一次，把主库中已有正文迁到对象存储（可中断、可重复执行）
# WORKDSH_BODY_STORE_MIGRATE=false

# 每日维护：清理过期登录、按组织保留天数清理正文、记录各表行数
# WORKDSH_MAINTENANCE_CRON=0 30 3 * * *
# WORKDSH_MAINTENANCE_ZONE=Asia/Shanghai
